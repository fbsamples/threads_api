extends layout.pug

block content
  style(type="text/css").
    #oembed {
      margin-top: 40px;
    }
  .button-group
    button(onclick="location.href='/login'") Log In
    if csrfToken
      form(action='/logout' method='POST')
        input(type='hidden' name='_csrf' value=csrfToken)
        button(type='submit') Log Out

    button#oembed(onclick="location.href='/oEmbed'") Embed Threads
