extends layout_with_account

block content
    p Top-level replies to <a href="/threads/#{threadId}">thread #{threadId}</a>

    if deletableReplies
        form#bulk-delete(action='/threads/delete' method='POST' onsubmit="return confirm('Are you sure? This permanently deletes your selected replies and cannot be undone.');")
            input(type='hidden' name='_csrf' value=csrfToken)
            input(type='hidden' name='csrfToken' value=deleteCsrfToken)
            button.delete-button(type='submit') Delete Selected

    include thread_replies_layout.pug

block scripts
    script(src='/scripts/form.js' type='text/javascript')
    script(src='/scripts/hide-reply.js' type='text/javascript')
    script.
        document.getElementById('select-all-replies')?.addEventListener('change', (event) => {
            for (const checkbox of document.querySelectorAll('.bulk-delete-checkbox')) {
                checkbox.checked = event.target.checked;
            }
        });
