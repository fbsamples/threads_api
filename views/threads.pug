extends layout_with_account

block content
    if canDelete
        form#bulk-delete(action='/threads/delete' method='POST' onsubmit="return confirm('Are you sure? This permanently deletes your selected posts and cannot be undone.');")
            input(type='hidden' name='_csrf' value=csrfToken)
            input(type='hidden' name='csrfToken' value=deleteCsrfToken)
            button.delete-button(type='submit') Delete Selected
    table.threads-list
        thead
            tr
                if canDelete
                    th
                        input(type='checkbox' id='select-all' aria-label='Select all deletable posts')
                th Post ID
                th Creation Date and Time
                th Author
                th Media Type
                th Text
                th Permalink
                th Media URL
                if canDelete
                    th Actions
        tbody
            each thread in threads
                tr.threads-list-item
                    if canDelete
                        td
                            if deletableMediaTypes.includes(thread.media_type)
                                input(type='checkbox' form='bulk-delete' name='thread_ids' value=thread.id class='bulk-delete-checkbox' aria-label=`Select post ${thread.id}`)
                    td.thread-id
                        a(href=`/threads/${thread.id}`)=thread.id
                    td.thread-timestamp
                        if getPostTimestampISO(thread.timestamp)
                            time(datetime=getPostTimestampISO(thread.timestamp) data-local-timestamp='')=formatPostTimestamp(thread.timestamp)
                        else
                            =formatPostTimestamp(thread.timestamp)
                    td.thread-author=thread.username
                    td.thread-type=thread.media_type
                    td.thread-text=thread.text
                    td.thread-permalink
                        a(href=thread.permalink target='_blank') View on Threads
                    td.thread-media-url
                        if thread.media_url
                            a(href=thread.media_url target='_blank') View Media File
                    if canDelete
                        td
                            if deletableMediaTypes.includes(thread.media_type)
                                form(action=`/threads/${thread.id}/delete` method='POST' onsubmit="return confirm('Are you sure? This permanently deletes your post and cannot be undone.');")
                                    input(type='hidden' name='_csrf' value=csrfToken)
                                    input(type='hidden' name='csrfToken' value=deleteCsrfToken)
                                    button(type='submit' aria-label='Delete Post' title='Delete Post') 🗑

    div.paging
        if paging.nextUrl
            div.paging-next
                a(href=paging.nextUrl) Next

        if paging.previousUrl
            div.paging-previous
                a(href=paging.previousUrl) Previous


block scripts
    script.
        document.getElementById('select-all')?.addEventListener('change', (event) => {
            for (const checkbox of document.querySelectorAll('.bulk-delete-checkbox')) {
                checkbox.checked = event.target.checked;
            }
        });
