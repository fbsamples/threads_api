extends layout_with_account

block content
    form(action='/publishingLimit' method='GET')
        input(type='submit' value='Refresh Counts')
    table
        thead
            tr
                th(scope='col') Quota
                th(scope='col') Summary
        tbody
            each quota in quotas
                tr
                    th(scope='row')=quota.name
                    if quota.usage && quota.window
                        td= `${quota.usage} in the last ${quota.window}.`
                    else
                        td Not Available

block scripts
    script(src='/scripts/publishing-limit.js' defer)
