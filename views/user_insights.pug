extends layout_with_account

block head
    meta(name='viewport' content='width=device-width, initial-scale=1')

block content
    .user-insights
        .insights-table-scroll(role='region' aria-label='User Insights Metrics' tabindex='0')
            include insights
        form.insights.insights-date-controls(action='/userInsights' method='GET')
            .insights-date-field
                label(for='since') Since
                input#since(type='date' name='since' value=since)
            .insights-date-field
                label(for='until') Until
                input#until(type='date' name='until' value=until)
            input#submit.threads-button(type='submit' value='Refine')
